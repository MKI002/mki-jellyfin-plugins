<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.SeerrBridge</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.SeerrBridge</RootNamespace>
    <Version>1.0.0.0</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Configuration/configPage.html" LogicalName="Jellyfin.Plugin.SeerrBridge.Configuration.configPage.html" />
    <EmbeddedResource Include="Web/seerr.css" LogicalName="Jellyfin.Plugin.SeerrBridge.Web.seerr.css" />
    <EmbeddedResource Include="Web/seerr.js" LogicalName="Jellyfin.Plugin.SeerrBridge.Web.seerr.js" />
  </ItemGroup>
</Project>
