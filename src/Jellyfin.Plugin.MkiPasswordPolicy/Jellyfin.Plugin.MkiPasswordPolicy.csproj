<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.MkiPasswordPolicy</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.MkiPasswordPolicy</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Configuration/configPage.html" LogicalName="Jellyfin.Plugin.MkiPasswordPolicy.Configuration.configPage.html" />
    <EmbeddedResource Include="Web/client.js" LogicalName="Jellyfin.Plugin.MkiPasswordPolicy.Web.client.js" />
    <EmbeddedResource Include="Web/change.html" LogicalName="Jellyfin.Plugin.MkiPasswordPolicy.Web.change.html" />
  </ItemGroup>
</Project>
