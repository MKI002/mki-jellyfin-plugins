<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.MediaHero</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.MediaHero</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Configuration/configPage.html" LogicalName="Jellyfin.Plugin.MediaHero.Configuration.configPage.html" />
    <EmbeddedResource Include="Web/mediahero.css" LogicalName="Jellyfin.Plugin.MediaHero.Web.mediahero.css" />
    <EmbeddedResource Include="Web/mediahero.js" LogicalName="Jellyfin.Plugin.MediaHero.Web.mediahero.js" />
  </ItemGroup>
</Project>
